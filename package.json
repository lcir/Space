{
  "name": "space-invaders-reborn",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/app.mjs",
    "test": "node test/run.mjs",
    "build": "node scripts/build.mjs",
    "static": "node scripts/serve.mjs --dist",
    "train": "node agents/train-cli.mjs",
    "test:server": "node --test --test-concurrency=1 test/server.test.mjs",
    "agent": "node agents/cli.mjs",
    "check": "npm test && npm run test:server && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
